<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Result</title>
    <link rel="stylesheet" href="/result.css">
</head>
<body>
    <div class="container">
  <div class="header">
    <div class="h-badge"></div>
    <h2>Form Submitted Successfully!</h2>
  </div>

  <div class="card">
    <h3>User Details</h3>
    <div class="row"><strong>Name:</strong> <span><%= user.name %></span></div>
    <div class="row"><strong>Email:</strong> <span><%= user.email %></span></div>
    <div class="row"><strong>Password:</strong> <span><%= user.password %></span></div>
    <hr>
    <a class="back" href="/">Go Back</a>
  </div>

  <div class="card">
    <h3>All Users (Temporary Storage)</h3>
    <ul class="users">
      <% users.forEach(u => { %>
        <li><strong><%= u.name %></strong> <small> — <%= u.email %> — <%= u.password %></small></li>
      <% }) %>
    </ul>
  </div>
</div>
</body>
</html>
